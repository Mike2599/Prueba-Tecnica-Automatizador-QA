# Copiar como .env y ajustar. El archivo .env NO se versiona.
# Ambiente: qa (por defecto). Ver config/environments.ts
TEST_ENV=qa

# --- Web (OrangeHRM demo) ---
# Credenciales publicas del demo. En un proyecto real se inyectan desde el Library/Key Vault del pipeline.
ORANGE_USER=Admin
ORANGE_PASSWORD=admin123

# --- API (ReqRes) ---
# Opcional: ReqRes puede exigir x-api-key segun sus condiciones vigentes. Si la exige, definirla aqui.
REQRES_API_KEY=
# Umbral de tiempo de respuesta de la API en ms (ver justificacion en README)
API_MAX_RESPONSE_MS=2000

# --- Ejecucion ---
HEADLESS=true
